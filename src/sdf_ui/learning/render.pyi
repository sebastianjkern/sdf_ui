from __future__ import annotations

from collections.abc import Mapping
from pathlib import Path
from typing import Any

from ..core.texture import TextureNode
from ..graph.lowering import GraphPlan
from .autodiff import Tensor

def _tensor(value: Any) -> Tensor: ...
def _rgb_to_lab(color: Tensor) -> Tensor: ...
def _lab_to_rgb(color: Tensor) -> Tensor: ...

class UnsupportedGradientError(ValueError): ...

class DifferentiableRenderer:
    size: tuple[int, int]
    params: Mapping[str, Any]
    ctx: DifferentiableRenderer
    x: Tensor
    y: Tensor
    def __init__(
        self, size: tuple[int, int], params: Mapping[str, Any] | None = ...
    ) -> None: ...
    def percent(self, value: Any) -> Any: ...
    def percent_x(self, value: Any) -> Any: ...
    def percent_y(self, value: Any) -> Any: ...
    def percent_of_min(self, value: Any) -> Any: ...
    @classmethod
    def supported_operations(cls) -> tuple[str, ...]: ...
    def render(self, scene: TextureNode) -> Tensor: ...
    def render_plan(self, plan: GraphPlan) -> dict[str, Tensor]: ...
    def save(self, scene: TextureNode, path: str | Path) -> Path: ...
