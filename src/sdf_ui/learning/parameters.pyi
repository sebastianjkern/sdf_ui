from __future__ import annotations

from collections.abc import Iterable, Iterator, Mapping
from pathlib import Path
from typing import Any

from ..core.expressions import Expr
from .autodiff import Parameter

class ParameterStore(Mapping[str, Parameter]):
    def __init__(self, parameters: Iterable[Parameter] = ...) -> None: ...
    def __getitem__(self, key: str) -> Parameter: ...
    def __iter__(self) -> Iterator[str]: ...
    def __len__(self) -> int: ...
    def add(self, parameter: Parameter) -> Parameter: ...
    def define(
        self, name: str, initial: Any, *, trainable: bool = ...
    ) -> Parameter: ...
    def bind(
        self, name: str, initial: Any = ..., *, trainable: bool | None = ...
    ) -> Expr: ...
    def scalar(
        self,
        name: str,
        *,
        initial: float,
        min: float | None = ...,
        max: float | None = ...,
    ) -> Expr: ...
    def scalar_expression(self, name: str) -> Expr: ...
    def assign_value(self, name: str, value: float) -> ParameterStore: ...
    def is_scalar(self, name: str) -> bool: ...
    def scalar_name(self, expression: Any) -> str | None: ...
    def raw_value(self, name: str, value: float) -> float: ...
    def value(self, name: str) -> float: ...
    def parameters(self) -> tuple[Parameter, ...]: ...
    def state_dict(self) -> dict[str, Any]: ...
    def schema(self) -> dict[str, Any]: ...
    def load_state_dict(self, state: Mapping[str, Any]) -> None: ...
    def save(self, path: str | Path) -> None: ...
    def load(self, path: str | Path) -> None: ...
