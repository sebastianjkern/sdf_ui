from __future__ import annotations

from typing import Any

class GPUBuffer:
    context: Any
    size: int
    closed: bool
    def __init__(self, context: Any, buffer: Any) -> None: ...
    def write(
        self, data: bytes | bytearray | memoryview, offset: int = ...
    ) -> None: ...
    def read(self, size: int | None = ..., offset: int = ...) -> bytes: ...
    def clear(self) -> None: ...
    def close(self) -> None: ...
    def release(self) -> None: ...
    def __enter__(self) -> GPUBuffer: ...
    def __exit__(self, *_: Any) -> None: ...
