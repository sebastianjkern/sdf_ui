    var Pf: vec4<f32> = (fract(P.xyxy) - vec4<f32>(0.0, 0.0, 1.0, 1.0));
    Pi = shadingMod289(Pi);
    var ix: vec4<f32> = Pi.xzxz;
    var iy: vec4<f32> = Pi.yyww;
    var fx: vec4<f32> = Pf.xzxz;
    var fy: vec4<f32> = Pf.yyww;
    var i: vec4<f32> = shadingPermute((shadingPermute(ix) + iy));
    var gx: vec4<f32> = ((fract((i * (1.0 / 41.0))) * 2.0) - 1.0);
    var gy: vec4<f32> = (abs(gx) - 0.5);
    var tx: vec4<f32> = floor((gx + 0.5));
    gx = (gx - tx);
    var g00: vec2<f32> = vec2<f32>(gx.x, gy.x);
    var g10: vec2<f32> = vec2<f32>(gx.y, gy.y);
    var g01: vec2<f32> = vec2<f32>(gx.z, gy.z);
    var g11: vec2<f32> = vec2<f32>(gx.w, gy.w);
    var norm: vec4<f32> = shadingTaylorInvSqrt(vec4<f32>(dot(g00, g00), dot(g01, g01), dot(g10, g10), dot(g11, g11)));
    g00 *= vec2<f32>(norm.x);
    g01 *= vec2<f32>(norm.y);
    g10 *= vec2<f32>(norm.z);
    g11 *= vec2<f32>(norm.w);
    var n00: f32 = dot(g00, vec2<f32>(fx.x, fy.x));
    var n10: f32 = dot(g10, vec2<f32>(fx.y, fy.y));
    var n01: f32 = dot(g01, vec2<f32>(fx.z, fy.z));
    var n11: f32 = dot(g11, vec2<f32>(fx.w, fy.w));
    var fade_xy: vec2<f32> = shadingFade(Pf.xy);
    var n_x: vec2<f32> = mix(vec2<f32>(n00, n01), vec2<f32>(n10, n11), fade_xy.x);
    var n_xy: f32 = mix(n_x.x, n_x.y, fade_xy.y);
    return (2.3 * n_xy);
}

fn evaluate(pos: vec2<i32>, o: ptr<function, array<D, 8>>) {
    var value: D = dualC(shadingCnoise((1.5 * (vec2<f32>(pos) / 256.0))));
    shadingOutput(D4(value, value, value, dualC(1.0)), o);
}

