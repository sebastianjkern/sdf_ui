        roots.x = roots.y;
        roots.y = tmp;
    }
    if ((roots.y > roots.z))     {
        var tmp: f32 = roots.y;
        roots.y = roots.z;
        roots.z = tmp;
    }
    if ((roots.x > roots.y))     {
