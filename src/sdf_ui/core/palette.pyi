from collections.abc import Iterable, Mapping
from typing import Any

Color = tuple[float, float, float, float]

class Palette:
    colors: tuple[Color, ...]
    name: str | None
    def __init__(self, colors: Iterable[Any], name: str | None = ...) -> None: ...
    def sample(self, position: float) -> Color: ...
    def steps(self, count: int) -> tuple[Color, ...]: ...
    def reversed(self) -> Palette: ...

palettes: Mapping[str, Palette]
def get_palette(value: str | Palette | Iterable[Any]) -> Palette: ...
