from __future__ import annotations

from collections.abc import Iterable, Mapping
from pathlib import Path
from typing import TYPE_CHECKING, Any, Iterator, Optional, Self, overload

from numpy.typing import NDArray

if TYPE_CHECKING:
    from .color import ColorTexture

class TextureNode:
    tex: Any
    context: Any
    op: str | None
    inputs: tuple[Any, ...]
    params: Any
    label: str | None
    should_cache: bool
    size: tuple[int, int]
    origin: tuple[int, int]
    canvas_size: tuple[int, int]
    @overload
    def __init__(self, tex: Any, context: Any, *, op: str | None = ..., inputs: Iterable[Any] = ..., params: Mapping[str, Any] | Iterable[Any] | None = ..., label: str | None = ..., should_cache: bool = ...) -> None: ...
    @overload
    def __init__(self, *, op: str, inputs: Iterable[Any] = ..., params: Mapping[str, Any] | Iterable[Any] | None = ..., label: str | None = ..., should_cache: bool = ...) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_: Any) -> None: ...
    def render(self, ctx: Any = None, params: Any = None, cache: Any = None, evaluation_rect: Any = None) -> Self: ...
    def read(self) -> NDArray[Any]: ...
    def show(self, ctx: Any = None, params: dict[str, Any] | None = None, cache: dict[Any, Any] | None = None, conversion: bool = True, size: tuple[int, int] | None = None, evaluation_rect: tuple[int, int, int, int] | None = None) -> None: ...
    def save(self, name: str | Path = './image.png', ctx: Any = None, params: dict[str, Any] | None = None, cache: dict[Any, Any] | None = None, conversion: bool = True, size: tuple[int, int] | None = None, evaluation_rect: tuple[int, int, int, int] | None = None) -> None: ...
    def named(self, label: str) -> Any: ...
    def cache(self, label: str | None = None) -> Any: ...
    def uncached(self) -> Any: ...

class PostNamespace:
    def to_lab(self) -> ColorTexture: ...
    def to_rgb(self) -> ColorTexture: ...
    def blur(self, n: Any = 0, base: Any = 9) -> ColorTexture: ...
    def blur_13(self, n: Any = 0) -> ColorTexture: ...
    def blur_9(self, n: Any = 0) -> ColorTexture: ...
    def dither_1bit(self) -> ColorTexture: ...
    def dithering(self) -> ColorTexture: ...
    def invert(self) -> ColorTexture: ...

class RenderStats:
    shader_dispatches: int
    shader_dispatches_by_name: dict[str, int]
    cache_hits: int
    cache_misses: int
    cache_writes: int
    cache_skips: int
    texture_allocations: int
    texture_allocations_by_kind: dict[str, int]
    render_calls: int
    elapsed_seconds: float
    def as_dict(self) -> dict[str, Any]: ...

class RenderCacheInfo:
    entries: int
    hits: int
    misses: int
    writes: int
    skips: int

class Renderer:
    stats: RenderStats
    def __init__(self, ctx: Any, params: Any = None, cache: Any = None, evaluation_rect: Any = None) -> None: ...
    def __enter__(self) -> Renderer: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...
    def render(self, value: Any) -> Any: ...
    def close(self) -> None: ...
    def clear_cache(self) -> Any: ...
    def cache_info(self) -> RenderCacheInfo: ...

class MultiOutputResult:
    op: str
    inputs: tuple[Any, ...]
    params: tuple[Any, ...]
    label: Optional[str]
    should_cache: bool
    kind: str
    def render(self, ctx: Any, params: Optional[dict[str, Any]] = ..., cache: Any = ...) -> Any: ...
    def __iter__(self) -> Iterator[Any]: ...
