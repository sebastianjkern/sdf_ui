from __future__ import annotations

from typing import Any

from .color import ColorTexture
from .texture import TextureNode

class FieldTexture(TextureNode):
    kind: str
    def scale(self, amount: Any) -> FieldTexture: ...
    def add(self, other: Any) -> FieldTexture: ...
    def visualize(self, scale: Any = 1.0, magnitude: Any = 1.0) -> ColorTexture: ...
    def contours(self, spacing: Any = 8.0, line_width: Any = 1.0, scale: Any = 1.0) -> ColorTexture: ...

class FieldNamespace:
    def constant(self, vector: Any = (0.0, 0.0)) -> FieldTexture: ...
    def radial(self, center: Any, radius: Any, strength: Any = 1.0) -> FieldTexture: ...
    def vortex(self, center: Any, radius: Any, strength: Any = 1.0) -> FieldTexture: ...
    def turbulence(self, frequency: Any = 0.012, amplitude: Any = 24.0, octaves: Any = 4, lacunarity: Any = 2.0, gain: Any = 0.5, seed: Any = 0) -> FieldTexture: ...
