from __future__ import annotations

from collections.abc import Callable, Iterable, Mapping
from pathlib import Path
from typing import Any, Literal, Self, overload

from numpy.typing import NDArray

from ..core.texture import TextureNode
from ..gpu.image import GPUImage
from ..learning.autodiff import Parameter, Tensor
from ..learning.objective import Objective
from .environment import NamedRenderEnvironment
from .lowering import GraphPlan

class RenderGraph:
    canvas: Any
    size: tuple[int, int]
    params: Any
    plan: GraphPlan
    backend: Any
    fingerprint: str
    parameters: tuple[Parameter, ...]
    trainable_parameters: tuple[Parameter, ...]
    inputs: Mapping[str, float]
    closed: bool
    def __init__(
        self,
        canvas: Any,
        outputs: Any,
        params: Any = ...,
        *,
        size: tuple[int, int] | None = ...,
        inputs: Mapping[str, Any] | None = ...,
    ) -> None: ...
    def set_inputs(
        self, values: Mapping[str, Any] | None = ..., **kwargs: float
    ) -> Self: ...
    def environment(
        self,
        *,
        actions: Mapping[str, Any],
        observations: Mapping[str, Any] | None = ...,
        objective: Objective | None = ...,
        reward: Callable[..., float] | None = ...,
        action_transform: Callable[..., Any] | None = ...,
        identity: Any = ...,
    ) -> NamedRenderEnvironment: ...
    def refresh_inputs(self) -> None: ...
    def check(self) -> None: ...
    def require_idle(self) -> None: ...
    def percent(self, value: Any) -> Any: ...
    def percent_x(self, value: Any) -> Any: ...
    def percent_y(self, value: Any) -> Any: ...
    def percent_of_min(self, value: Any) -> Any: ...
    def run(self, objective: Objective | None = ...) -> GraphExecution: ...
    def execute(self, objective: Objective | None = ...) -> GraphExecution: ...
    @overload
    def render(
        self, *, backend: Literal["display"] = ...
    ) -> dict[str, TextureNode]: ...
    @overload
    def render(self, *, backend: Literal["reference"]) -> dict[str, Tensor]: ...
    @overload
    def render(self, *, backend: Literal["training"]) -> dict[str, GPUImage]: ...
    def explain(self) -> dict[str, Any]: ...
    def snapshot(self, name: str) -> GPUImage: ...
    def save(self, name: str, path: str | Path) -> Path: ...
    def clear_cache(self) -> None: ...
    def cache_info(self) -> dict[str, int]: ...
    def objective_signature(
        self, objective: Objective, *, portable: bool = ...
    ) -> str: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_: Any) -> None: ...

class GraphExecution:
    graph: RenderGraph
    objective: Objective | None
    outputs: Mapping[str, GPUImage]
    loss: float | None
    metrics: dict[str, float]
    closed: bool
    backward_called: bool
    cache_hits: int
    stats: dict[str, int]
    def __init__(
        self, graph: RenderGraph, objective: Objective | None = ...
    ) -> None: ...
    def backward(self) -> dict[str, NDArray[Any] | None]: ...
    def read(self, name: str) -> NDArray[Any]: ...
    def gradient(self, name: str) -> NDArray[Any]: ...
    def input_gradient(self, index: int) -> NDArray[Any]: ...
    def save(self, name: str, path: str | Path) -> Path: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_: Any) -> None: ...

class GraphTrainer:
    graph: RenderGraph
    objective: Objective
    optimizer: Any
    steps: int
    last_metrics: dict[str, Any] | None
    closed: bool
    def __init__(
        self,
        graph: RenderGraph,
        objective: Objective,
        optimizer: Any = ...,
        *,
        lr: float = ...,
    ) -> None: ...
    def check(self) -> None: ...
    def step(self) -> dict[str, Any]: ...
    def step_batch(self, cases: Iterable[Any]) -> dict[str, Any]: ...
    def evaluate(self) -> dict[str, Any]: ...
    def fit(
        self,
        steps: int,
        callback: Callable[[dict[str, Any]], Any] | None = ...,
        *,
        validation: Callable[[], float | Mapping[str, Any]] | None = ...,
        patience: int | None = ...,
        min_delta: float = ...,
        restore_best: bool = ...,
        validation_interval: int = ...,
    ) -> list[dict[str, Any]]: ...
    def state_dict(self) -> dict[str, Any]: ...
    def load_state_dict(self, state: Mapping[str, Any]) -> None: ...
    def save(self, path: str | Path) -> None: ...
    def load(self, path: str | Path) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_: Any) -> None: ...
