from __future__ import annotations

from collections.abc import Callable, Iterable, Mapping
from pathlib import Path
from typing import Any, Self

from ..learning.objective import Objective
from .runtime import RenderGraph

class GraphCase:
    graph: RenderGraph
    objective: Objective
    name: str
    weight: float
    def __init__(
        self, graph: RenderGraph, objective: Objective, name: str, weight: float = ...
    ) -> None: ...

class GraphDatasetTrainer:
    cases: tuple[GraphCase, ...]
    last_metrics: dict[str, Any] | None
    @property
    def optimizer(self) -> Any: ...
    @property
    def steps(self) -> int: ...
    def __init__(
        self, cases: Iterable[GraphCase], optimizer: Any = ..., *, lr: float = ...
    ) -> None: ...
    def evaluate(self, cases: Iterable[GraphCase] | None = ...) -> dict[str, Any]: ...
    def step(self, cases: Iterable[GraphCase] | None = ...) -> dict[str, Any]: ...
    def fit(
        self,
        steps: int,
        callback: Callable[[dict[str, Any]], Any] | None = ...,
        *,
        validation: Callable[[], float | Mapping[str, Any]] | None = ...,
        patience: int | None = ...,
        min_delta: float = ...,
        restore_best: bool = ...,
        validation_interval: int = ...,
    ) -> list[dict[str, Any]]: ...
    def state_dict(self) -> dict[str, Any]: ...
    def load_state_dict(self, state: Mapping[str, Any]) -> None: ...
    def save(self, path: str | Path) -> None: ...
    def load(self, path: str | Path) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *_: Any) -> None: ...
